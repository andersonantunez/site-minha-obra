# Aplicacao
NODE_ENV=development
WEB_URL=http://localhost:5174
API_URL=http://localhost:3002
PORT=3002

# PostgreSQL - db_casa_dals
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/db_casa_dals
DATABASE_SSL=false

# Autenticacao
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
JWT_SECRET=
JWT_EXPIRES_IN=8h

# Convites (SMTP opcional nesta fase)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=obracasadals@gmail.com
SMTP_PASSWORD=

# Arquivos locais; pode ser substituido por storage externo futuramente
UPLOAD_DIR=apps/api/uploads
MAX_UPLOAD_MB=15
